# Hosting platforms usually set PORT; API_PORT overrides it locally.
API_PORT=3001
# Where order requests are sent (Magnus' inbox)
ORDER_INBOX=magnus@example.com
MAIL_FROM="Magnus Honung <no-reply@magnushonung.se>"
# Leave SMTP_HOST empty in development: emails are then printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: serve the built frontend from the API (single deploy)
STATIC_DIR=../web/dist
